<Window x:Class="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LUZ GRAND HOTEL - Réception &amp; Accueil" 
    Width="1600" Height="900" 
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F5">
    <DockPanel>
        <!-- Menu -->
        <StackPanel DockPanel.Dock="Top" Background="White" Height="50" Orientation="Horizontal" Padding="10">
            <TextBlock Text="LUZ GRAND HOTEL" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#333"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Name="DateTimeDisplay" Text="" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="12"/>
                <Button Content="Importer XML" Padding="10,5" Margin="5" Background="#28A745" Foreground="White"/>
                <Button Content="Reset" Padding="10,5" Margin="5" Background="#DC3545" Foreground="White"/>
                <Button Content="Quitter" Padding="10,5" Margin="5" Background="#6C757D" Foreground="White"/>
            </StackPanel>
        </StackPanel>

        <!-- Onglets -->
        <TabControl DockPanel.Dock="Top" Margin="10">
            <!-- ONGLET 1 : RÉCEPTION -->
            <TabItem Header="Réception (Jour)" Name="TabReception">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Formulaire Saisie (Gauche) -->
                    <StackPanel Grid.Column="0" Padding="15">
                        <TextBlock Text="Nouvelle Arrivée" Style="{StaticResource HeaderText}" Foreground="#0078D4"/>
                        
                        <TextBlock Text="Nom Client:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBox Name="TxNomClient" Padding="8" Height="35" Margin="0,0,0,10" FontSize="12"/>

                        <TextBlock Text="Civilité:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ComboBox Name="CbCivilite" Padding="8" Height="35" Margin="0,0,0,10" FontSize="12">
                            <ComboBoxItem>Monsieur</ComboBoxItem>
                            <ComboBoxItem>Madame</ComboBoxItem>
                            <ComboBoxItem>Mademoiselle</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="N° Chambre:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBox Name="TxNChambre" Padding="8" Height="35" Margin="0,0,0,10" FontSize="12" Text="101"/>

                        <TextBlock Text="Date Arrivée:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="TxDateArr" Padding="8" Height="35" Grid.Column="0"/>
                            <Button Content="📅" Grid.Column="1" Margin="5,0,0,0" Background="#007ACC" Foreground="White"/>
                        </Grid>

                        <TextBlock Text="Date Départ:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="TxDateDep" Padding="8" Height="35" Grid.Column="0"/>
                            <Button Content="📅" Grid.Column="1" Margin="5,0,0,0" Background="#007ACC" Foreground="White"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Enregistrer" Padding="10,8" Margin="0,0,5,0" Background="#28A745" Foreground="White" Width="145"/>
                            <Button Content="Effacer" Padding="10,8" Margin="5,0,0,0" Background="#FFC107" Foreground="Black" Width="145"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Préview Carton Clé (Milieu) -->
                    <Border Grid.Column="1" Margin="10" BorderBrush="#DDD" BorderThickness="1" Background="White">
                        <StackPanel Padding="15">
                            <TextBlock Text="Aperçu Carton Clé (A6)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <Border BorderBrush="#CCC" BorderThickness="2" Height="300" Background="#FFFAF0">
                                <StackPanel Padding="20" VerticalAlignment="Center">
                                    <TextBlock Name="CardKeyTitle" Text="Mr. DUPONT" FontSize="10" FontFamily="MVBoli" Margin="0,10,0,30"/>
                                    <TextBlock Name="CardKeyRoom" Text="101" FontSize="36" FontFamily="MVBoli" TextAlignment="Center" FontWeight="Bold" Margin="0,30"/>
                                    <TextBlock Name="CardKeyDates" Text="12/05/2026 - 14/05/2026" FontSize="9" FontFamily="MVBoli" TextAlignment="Center" Margin="0,30,0,10"/>
                                </StackPanel>
                            </Border>
                            <Button Content="Imprimer Carton" Padding="10,8" Margin="0,10,0,0" Background="#007ACC" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- Préview Welcome Letter (Droite) -->
                    <Border Grid.Column="2" Margin="10" BorderBrush="#DDD" BorderThickness="1" Background="White">
                        <StackPanel Padding="15">
                            <TextBlock Text="Aperçu Welcome Letter" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <Border BorderBrush="#CCC" BorderThickness="2" Height="300" Background="White">
                                <TextBlock Name="WelcomePreview" Text="Saint-Jean-de-Luz, le 12 mai 2026&#10;&#10;Cher Monsieur DUPONT,&#10;&#10;La direction et l'ensemble du personnel..." 
                                           Padding="15" TextWrapping="Wrap" FontSize="10" FontFamily="Aptos"/>
                            </Border>
                            <TextBlock Text="Formule Politesse:" FontWeight="Bold" Margin="0,10,0,5" FontSize="10"/>
                            <TextBox Name="TxFormulePolitesse" Padding="8" Height="40" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="10"/>
                            <Button Content="Imprimer Welcome" Padding="10,8" Margin="0,0,0,0" Background="#007ACC" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ONGLET 2 : RÉSERVATIONS -->
            <TabItem Header="Réservations (Nuit)" Name="TabReservations">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tableau (Gauche) -->
                    <StackPanel Grid.Column="0" Padding="15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="◀" Padding="5" Margin="0,0,5,0" Width="30"/>
                            <TextBlock Name="DateFilterDisplay" Text="12 mai 2026" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="0,0,5,0"/>
                            <Button Content="▶" Padding="5" Margin="5,0,0,0" Width="30"/>
                            <ComboBox Name="CbDestination" Margin="20,0,0,0" Width="150" Padding="8">
                                <ComboBoxItem>Imprimante directe</ComboBoxItem>
                                <ComboBoxItem>Boîte dialogue</ComboBoxItem>
                                <ComboBoxItem>Export PDF</ComboBoxItem>
                                <ComboBoxItem>Export DOCX</ComboBoxItem>
                                <ComboBoxItem>Export XLSX</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <DataGrid Name="DgReservations" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,10">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Width="30"/>
                                <DataGridTextColumn Header="Chambre" Width="70" Binding="{Binding NumerosChambre}"/>
                                <DataGridTextColumn Header="Nom" Width="100" Binding="{Binding NomClient}"/>
                                <DataGridTextColumn Header="Prénom" Width="100" Binding="{Binding PrenomClient}"/>
                                <DataGridTextColumn Header="Civilité" Width="80" Binding="{Binding CiviliteClient}"/>
                                <DataGridTextColumn Header="Arrivée" Width="90" Binding="{Binding DateArrivee, StringFormat=dd/MM/yyyy}"/>
                                <DataGridTextColumn Header="Départ" Width="90" Binding="{Binding DateDepart, StringFormat=dd/MM/yyyy}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Imprimer Portrait" Padding="10,5" Margin="0,0,5,0" Background="#17A2B8" Foreground="White" Width="150"/>
                            <Button Content="Imprimer Paysage" Padding="10,5" Margin="5,0,0,0" Background="#17A2B8" Foreground="White" Width="150"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Formulaire (Droite) -->
                    <Border Grid.Column="1" Margin="10" BorderBrush="#DDD" BorderThickness="1" Background="#F9F9F9">
                        <StackPanel Padding="15" Margin="0,0,0,10">
                            <TextBlock Text="Détails Réservation" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                            <TextBlock Text="Nom:" FontSize="10" FontWeight="Bold" Margin="0,5,0,2"/>
                            <TextBox Name="DgNom" Padding="5" Height="28" FontSize="10" Margin="0,0,0,5"/>

                            <TextBlock Text="Civilité:" FontSize="10" FontWeight="Bold" Margin="0,5,0,2"/>
                            <ComboBox Name="DgCivilite" Padding="5" Height="28" FontSize="10" Margin="0,0,0,5"/>

                            <TextBlock Text="Chambre:" FontSize="10" FontWeight="Bold" Margin="0,5,0,2"/>
                            <TextBox Name="DgChambre" Padding="5" Height="28" FontSize="10" Margin="0,0,0,5"/>

                            <TextBlock Text="Arrivée:" FontSize="10" FontWeight="Bold" Margin="0,5,0,2"/>
                            <TextBox Name="DgArrivee" Padding="5" Height="28" FontSize="10" Margin="0,0,0,5"/>

                            <TextBlock Text="Départ:" FontSize="10" FontWeight="Bold" Margin="0,5,0,2"/>
                            <TextBox Name="DgDepart" Padding="5" Height="28" FontSize="10" Margin="0,0,0,5"/>

                            <Button Content="Enregistrer" Padding="8,5" Margin="0,15,0,5" Background="#28A745" Foreground="White" FontSize="10"/>
                            <Button Content="Carton Clé" Padding="8,5" Margin="0,5" Background="#007ACC" Foreground="White" FontSize="10"/>
                            <Button Content="Welcome Letter" Padding="8,5" Margin="0,5" Background="#007ACC" Foreground="White" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ONGLET 3 : STATISTIQUES -->
            <TabItem Header="Statistiques (KPI)" Name="TabStats">
                <StackPanel Padding="15" Background="White">
                    <TextBlock Text="Tableau de Bord KPI" Style="{StaticResource HeaderText}" Foreground="#0078D4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,10,0" Background="#E8F4F8" Width="200">
                            <StackPanel>
                                <TextBlock Text="Arrivées" FontSize="12" FontWeight="Bold" Foreground="#0078D4"/>
                                <TextBlock Name="KpiArrivees" Text="12" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="10,0" Background="#E8F4F8" Width="200">
                            <StackPanel>
                                <TextBlock Text="Personnes" FontSize="12" FontWeight="Bold" Foreground="#0078D4"/>
                                <TextBlock Name="KpiPersonnes" Text="28" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="10,0" Background="#E8F4F8" Width="200">
                            <StackPanel>
                                <TextBlock Text="Occupation" FontSize="12" FontWeight="Bold" Foreground="#0078D4"/>
                                <TextBlock Name="KpiOccupation" Text="65%" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <TextBlock Name="StatusText" Text="Prêt" Foreground="#333"/>
        </StatusBar>
    </DockPanel>
</Window>
